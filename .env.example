# First-run admin password (otherwise a random one is printed once in the logs)
CROWS_EYE_ADMIN_PASSWORD=change-me-to-something-long
# Set to 1 when served over HTTPS (recommended) so the session cookie is Secure
CROWS_EYE_SECURE_COOKIES=1
# Set to 1 ONLY behind a reverse proxy you control (uses the last X-Forwarded-For hop for login throttling)
CROWS_EYE_TRUST_PROXY=1
# Optional: password for SMTP alerts (configure host/user/recipient in Settings)
CROWS_EYE_SMTP_PASSWORD=
# CROWS_EYE_DEMO=1   # synthetic data for trying the UI; do not use in production
